# NapCat quick-login template.
# Copy to: data/napcat_login.env  (data/ is git-ignored, so secrets never reach the repo)
#
# 1) Bot QQ account (required)
NAPCAT_QUICK_ACCOUNT=3983079058
#
# 2) Password fallback (pick ONE; leave both empty to rely on the cached quick-login ticket,
#    which means a QR scan is needed whenever that ticket expires)
#    plaintext - NapCat hashes it in memory only, nothing is written to disk
# NAPCAT_QUICK_PASSWORD=
#    or 32-char lowercase MD5 (recommended)
# NAPCAT_QUICK_PASSWORD_MD5=
